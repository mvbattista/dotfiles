[alias]
	tree = log --graph --oneline --decorate --all
	graph = log --graph --oneline --decorate
	st = status -sb

[core]
	excludesfile = ~/.gitignore_global
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main

# Identity, Sourcetree tools, insteadOf, commit template: per profile, installed as ~/.gitconfig.local.
# Included last so it overrides anything above.
[include]
	path = ~/.gitconfig.local
